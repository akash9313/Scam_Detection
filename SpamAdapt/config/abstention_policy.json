  "description": "Three-tier classification policy for high-reliability SMS spam filtering. Softmax output scores between tau_low and tau_high reflect epistemic or boundary uncertainty and are routed to 'REVIEW_REQUIRED' rather than automated blocking or acceptance.",
  "calibration_disclaimer": "Softmax outputs reflect model scoring on pre-trained BERT embeddings rather than guaranteed true frequentist probabilities. Calibration metrics (ECE ~ 0.01) on validation do not imply infallible out-of-domain calibration. The abstention window is configurable.",
  "decision_rules": {
    "HAM": "P(spam) < tau_low (High confidence legitimate message)",
    "SUSPECTED_SPAM": "P(spam) >= tau_high (High confidence spam/fraud)",
    "REVIEW_REQUIRED": "tau_low <= P(spam) < tau_high (Uncertain boundary; manual or secondary triage required)"
  },
